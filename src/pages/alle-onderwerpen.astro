---
import { Grid, Heading, Link, UnorderedList } from '@amsterdam/design-system-react';
import SiteLayout from '../components/SiteLayout';
import { getThemes } from '../lib/openProduct';
import '@amsterdam/design-system-tokens/dist/index.theme.css';
import '@amsterdam/design-system-css/dist/index.css';

const themes = await getThemes();
---

<html lang="nl" class="ams-theme">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Alle onderwerpen van de gemeente Amsterdam" />
    <title>Alle onderwerpen | Gemeente Amsterdam</title>
  </head>
  <body class="ams-body">
    <SiteLayout>
      <Grid as="main" id="inhoud" paddingTop="large" paddingBottom="x-large">
        <Grid.Cell span={{ narrow: 4, medium: 7, wide: 9 }} start={{ narrow: 1, medium: 1, wide: 2 }}>
          <Heading className="ams-mb-xl" level={1}>Alle onderwerpen</Heading>
          <UnorderedList>
            {themes.map((theme) => (
              <UnorderedList.Item>
                <Link href={`/${theme.slug}`}>{theme.name}</Link>
              </UnorderedList.Item>
            ))}
          </UnorderedList>
        </Grid.Cell>
      </Grid>
    </SiteLayout>
  </body>
</html>
